/-- A list of exponents read as a shape (missing entries are `0`). -/
def toShape (r : List ℕ) : PrimeShape 15 := fun i => r.getD i 0

/-- Row `k` of the table, as a list of 15 exponents. -/
def irrepRow (k : ℕ) : List ℕ := irrepExpList.getD k []

/-- The exponent vector of the `k`-th irreducible representation. -/
def irrepExp (k : Fin 194) : PrimeShape 15 := toShape (irrepRow k)

/-- The degree encoded by row `k`: `∏ p_i ^ e_i` over the 15 supersingular primes. -/
def irrepDegree (k : Fin 194) : ℕ := godel sspBasis (irrepExp k)

/-- The rows of the user's table are indexed by exactly `0, …, 193`. -/
theorem userTable_indices : (userTable.map (·.1)).Perm (List.range 194) := by
  decide +kernel

/-- `irrepExp` is a faithful transcription: every row has 15 exponents, `irrepExp` agrees with it,
and its `row_exponent_sum` is its mass. -/
theorem userTable_faithful :
    ∀ r ∈ userTable, ∃ h : r.1 < 194, List.ofFn (irrepExp ⟨r.1, h⟩) = r.2.1 ∧
      mass (irrepExp ⟨r.1, h⟩) = r.2.2 := by
  decide +kernel

/-- Exponent-wise domination gives divisibility of Gödel numbers. -/
theorem godel_dvd_godel {n : ℕ} (B : PrimeBasis n) {v w : PrimeShape n} (h : ∀ i, v i ≤ w i) :
    godel B v ∣ godel B w := by
  rw [godel_eq_prod, godel_eq_prod]
  exact Finset.prod_dvd_prod_of_dvd _ _ fun i _ => pow_dvd_pow _ (h i)

/-- Every exponent is at most the corresponding exponent of `|M|`. -/
theorem irrepExp_le_monster : ∀ k i, irrepExp k i ≤ monsterExponents i := by
  decide +kernel

/-- Every encoded degree divides the order of the Monster. -/
theorem irrepDegree_dvd_monster (k : Fin 194) :
    irrepDegree k ∣ godel sspBasis monsterExponents :=
  godel_dvd_godel sspBasis (irrepExp_le_monster k)

/-- **Sum of squares**: the squares of the 194 encoded degrees add up to `|M|`. -/
theorem sum_sq_irrepDegree :
    ∑ k : Fin 194, irrepDegree k ^ 2 = godel sspBasis monsterExponents := by
  rw [← List.sum_ofFn]
  decide +kernel

theorem sum_sq_irrepDegree_eq :
    ∑ k : Fin 194, irrepDegree k ^ 2 = 808017424794512875886459904961710757005754368000000000 := by
  rw [sum_sq_irrepDegree, godel_monsterExponents]

/-- The first five degrees (the first four are the user's `irrepDim` table). -/
theorem irrepDegree_small :
    irrepDegree 0 = 1 ∧ irrepDegree 1 = 196883 ∧ irrepDegree 2 = 21296876 ∧
      irrepDegree 3 = 842609326 ∧ irrepDegree 4 = 18538750076 := by
  decide +kernel

theorem irrepDegree_eq_irrepDim : ∀ k : Fin 4, irrepDegree ⟨k, by omega⟩ = irrepDim k := by
  decide +kernel

/-- The largest degree. -/
theorem irrepDegree_193 : irrepDegree 193 = 258823477531055064045234375 := by
  decide +kernel

/-- The trivial representation is the zero shape (the FRACTRAN state `1`). -/
theorem irrepExp_zero : irrepExp 0 = fun _ => 0 := by decide +kernel

/-- The 194 rows have exactly 170 distinct exponent vectors. -/
theorem irrepExp_distinct_count : ((List.finRange 194).map fun k => List.ofFn (irrepExp k)).dedup.length = 170 := by
  decide +kernel

/-- Every row has mass at most 56, attained by row 192. -/
theorem irrep_mass_le : ∀ k, mass (irrepExp k) ≤ 56 := by decide +kernel

theorem irrep_mass_192 : mass (irrepExp 192) = 56 := by decide +kernel

