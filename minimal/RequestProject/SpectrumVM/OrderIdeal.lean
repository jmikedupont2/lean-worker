module

public import Mathlib

/-!
# SpectrumVM §4/§5/§8: divisibility order ideals (K5, K6, IDEAL.MAXIMA insertion)

All order sets live in `ℕ_{>0}` (review §5): a finite divisibility downset can never contain `0`
(`zero_not_mem_of_downset`), and validated ideals carry positivity of their generators.
-/

@[expose] public section

namespace SpectrumVM

/-- Divisor closure of a set of generators: `{d | ∃ m ∈ M, d ∣ m}`. -/
def divClosure (M : Set ℕ) : Set ℕ := {d | ∃ m ∈ M, d ∣ m}

/-- Divisibility downset. -/
def IsDivDownset (S : Set ℕ) : Prop := ∀ m ∈ S, ∀ d, d ∣ m → d ∈ S

/-- Divisibility-maximal elements `μ(S)`. -/
def divMaxima (S : Finset ℕ) : Finset ℕ := S.filter fun a => ∀ b ∈ S, a ∣ b → a = b

theorem divMaxima_subset (S : Finset ℕ) : divMaxima S ⊆ S := Finset.filter_subset _ _

theorem divClosure_isDivDownset (M : Set ℕ) : IsDivDownset (divClosure M) := by
  rintro m ⟨b, hb, hmb⟩ d hd
  exact ⟨b, hb, hd.trans hmb⟩

theorem subset_divClosure (M : Set ℕ) : M ⊆ divClosure M := fun m hm => ⟨m, hm, dvd_rfl⟩

/-- A finite divisibility downset does not contain `0`. -/
theorem zero_not_mem_of_downset {S : Finset ℕ} (hS : IsDivDownset (S : Set ℕ)) : 0 ∉ S := by
  intro h0
  have : S.sup id + 1 ∈ S := hS 0 h0 _ (dvd_zero _)
  have := Finset.le_sup (f := id) this
  simp only [id] at this
  omega

/-- **K5 (ideal decomposition).** A finite divisibility downset is the divisor closure of its
divisibility-maximal elements. -/
theorem downset_eq_divClosure_maxima {S : Finset ℕ} (hS : IsDivDownset (S : Set ℕ)) :
    (S : Set ℕ) = divClosure (divMaxima S : Set ℕ) := by
  apply Set.Subset.antisymm
  · intro a ha
    have ha : a ∈ S := ha
    set T := S.filter (a ∣ ·) with hT
    have hTne : T.Nonempty := ⟨a, Finset.mem_filter.mpr ⟨ha, dvd_rfl⟩⟩
    have hbT := Finset.max'_mem T hTne
    set b := T.max' hTne
    obtain ⟨hbS, hab⟩ := Finset.mem_filter.mp hbT
    refine ⟨b, ?_, hab⟩
    simp only [divMaxima, Finset.coe_filter, Set.mem_setOf_eq]
    refine ⟨hbS, fun c hc hbc => ?_⟩
    have hcT : c ∈ T := Finset.mem_filter.mpr ⟨hc, hab.trans hbc⟩
    have hcb : c ≤ b := Finset.le_max' T c hcT
    have hc0 : c ≠ 0 := fun h => zero_not_mem_of_downset hS (h ▸ hc)
    exact le_antisymm (Nat.le_of_dvd (Nat.pos_of_ne_zero hc0) hbc) hcb
  · rintro d ⟨m, hm, hdm⟩
    exact hS m (divMaxima_subset S hm) d hdm

/-- **K6 (containment criterion)**, generator form: `div(μL) ⊆ div(μT)` iff every generator of
`L` divides some generator of `T`. -/
theorem divClosure_subset_iff (ML MT : Set ℕ) :
    divClosure ML ⊆ divClosure MT ↔ ∀ a ∈ ML, ∃ b ∈ MT, a ∣ b := by
  constructor
  · intro h a ha
    exact h (subset_divClosure ML ha)
  · rintro h d ⟨a, ha, hda⟩
    obtain ⟨b, hb, hab⟩ := h a ha
    exact ⟨b, hb, hda.trans hab⟩

/-- **K6** for finite downsets: `L ⊆ T` iff every maximum of `L` divides a maximum of `T`
(the criterion and its converse). -/
theorem downset_subset_iff {L T : Finset ℕ} (hL : IsDivDownset (L : Set ℕ))
    (hT : IsDivDownset (T : Set ℕ)) :
    L ⊆ T ↔ ∀ a ∈ divMaxima L, ∃ b ∈ divMaxima T, a ∣ b := by
  rw [← Finset.coe_subset, downset_eq_divClosure_maxima hL, downset_eq_divClosure_maxima hT,
    divClosure_subset_iff]
  rfl

/-- The finite set of all divisors of a list of generators. -/
def divisorsOf (l : List ℕ) : Finset ℕ := l.foldr (fun m s => m.divisors ∪ s) ∅

theorem divClosure_eq_divisorsOf (l : List ℕ) (hpos : ∀ m ∈ l, 0 < m) :
    divClosure {m | m ∈ l} = (divisorsOf l : Set ℕ) := by
  induction l with
  | nil => ext d; simp [divClosure, divisorsOf]
  | cons a t ih =>
    have ih := ih fun m hm => hpos m (List.mem_cons_of_mem a hm)
    have ha := hpos a (List.mem_cons_self)
    ext d
    have hd := congrArg (d ∈ ·) ih
    simp only [divClosure, Set.mem_setOf_eq, Finset.mem_coe, eq_iff_iff] at hd
    simp only [divClosure, divisorsOf, List.foldr_cons, List.mem_cons, Set.mem_setOf_eq,
      Finset.coe_union, Set.mem_union, Finset.mem_coe, Nat.mem_divisors] at hd ⊢
    rw [← hd]
    constructor
    · rintro ⟨m, rfl | hm, hdm⟩
      · exact Or.inl ⟨hdm, ha.ne'⟩
      · exact Or.inr ⟨m, hm, hdm⟩
    · rintro (⟨hdm, -⟩ | ⟨m, hm, hdm⟩)
      · exact ⟨a, Or.inl rfl, hdm⟩
      · exact ⟨m, Or.inr hm, hdm⟩

/-! ### IDEAL.MAXIMA insertion rule (RFC §8) -/

/-- Antichain under divisibility. -/
def IsDvdAntichain (l : List ℕ) : Prop := l.Pairwise fun a b => ¬ a ∣ b ∧ ¬ b ∣ a

/-- Insert `k`: if `k` divides an existing maximum do nothing; otherwise remove every maximum that
divides `k` and insert `k`. -/
def insertMax (ms : List ℕ) (k : ℕ) : List ℕ :=
  if ms.any (fun m => k ∣ m) then ms else k :: ms.filter (fun m => !(m ∣ k))

/-- Insertion computes the ideal generated by the old ideal and `k`. -/
theorem divClosure_insertMax (ms : List ℕ) (k : ℕ) :
    divClosure {m | m ∈ insertMax ms k} = divClosure {m | m ∈ ms} ∪ {d | d ∣ k} := by
  ext d
  simp only [divClosure, insertMax, Set.mem_setOf_eq, Set.mem_union]
  split_ifs with h
  · simp only [List.any_eq_true, decide_eq_true_eq] at h
    obtain ⟨m, hm, hkm⟩ := h
    constructor
    · exact Or.inl
    · rintro (h | h)
      · exact h
      · exact ⟨m, hm, h.trans hkm⟩
  · simp only [List.mem_cons, List.mem_filter, Bool.not_eq_eq_eq_not, Bool.not_true,
      decide_eq_false_iff_not]
    constructor
    · rintro ⟨m, rfl | ⟨hm, -⟩, hdm⟩
      · exact Or.inr hdm
      · exact Or.inl ⟨m, hm, hdm⟩
    · rintro (⟨m, hm, hdm⟩ | h)
      · by_cases hmk : m ∣ k
        · exact ⟨k, Or.inl rfl, hdm.trans hmk⟩
        · exact ⟨m, Or.inr ⟨hm, hmk⟩, hdm⟩
      · exact ⟨k, Or.inl rfl, h⟩

/-- Insertion preserves the antichain invariant. -/
theorem insertMax_antichain {ms : List ℕ} (h : IsDvdAntichain ms) (k : ℕ) :
    IsDvdAntichain (insertMax ms k) := by
  unfold insertMax IsDvdAntichain at *
  split_ifs with hk
  · exact h
  · simp only [List.any_eq_true, decide_eq_true_eq, not_exists, not_and] at hk
    refine List.Pairwise.cons ?_ (h.filter _)
    intro m hm
    simp only [List.mem_filter, Bool.not_eq_eq_eq_not, Bool.not_true,
      decide_eq_false_iff_not] at hm
    exact ⟨hk m hm.1, hm.2⟩

/-- Validated order ideal: positive generators forming a divisibility antichain. -/
structure OrderIdeal where
  maxima : List ℕ
  pos : ∀ m ∈ maxima, 0 < m
  antichain : IsDvdAntichain maxima

/-- The set of orders described by an ideal. -/
def OrderIdeal.carrier (I : OrderIdeal) : Set ℕ := divClosure {m | m ∈ I.maxima}

theorem OrderIdeal.carrier_pos (I : OrderIdeal) {d : ℕ} (hd : d ∈ I.carrier) : 0 < d := by
  obtain ⟨m, hm, hdm⟩ := hd
  exact Nat.pos_of_dvd_of_pos hdm (I.pos m hm)

/-- Insertion of a positive order into a validated ideal. -/
def OrderIdeal.insert (I : OrderIdeal) (k : ℕ) (hk : 0 < k) : OrderIdeal where
  maxima := insertMax I.maxima k
  pos m hm := by
    unfold insertMax at hm
    split_ifs at hm
    · exact I.pos m hm
    · rcases List.mem_cons.mp hm with rfl | hm
      · exact hk
      · exact I.pos m (List.mem_filter.mp hm).1
  antichain := insertMax_antichain I.antichain k

theorem OrderIdeal.carrier_insert (I : OrderIdeal) (k : ℕ) (hk : 0 < k) :
    (I.insert k hk).carrier = I.carrier ∪ {d | d ∣ k} :=
  divClosure_insertMax _ _

end SpectrumVM

end
