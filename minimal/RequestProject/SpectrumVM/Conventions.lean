module

public import Mathlib

/-!
# SpectrumVM §2/§4: binding conventions, root data, reflections, words (milestone M0)

Conventions (RFC §2), fixed for every artifact:

* basis = simple roots, vectors = columns,
* `cartan i j = ⟨α_i^∨, α_j⟩`,
* `(s_i)_{jk} = δ_{jk} - δ_{ji} * cartan i k`,
* `wordMat [i₀, …, i_k] = s_{i₀} * ⋯ * s_{i_k}` (the rightmost factor acts first).

The Cartan matrix is *derived* from a Mathlib `CoxeterMatrix` (diagonal `2`, entry `3 ↦ -1`,
entry `2 ↦ 0`), and a `RootDatum` additionally carries the admissibility proof that the Coxeter
matrix is simply laced (review §3).  The semantic group is `MatrixW R`, the subgroup of invertible
integer matrices generated by the simple reflections.
-/

@[expose] public section

namespace SpectrumVM

open Matrix

variable {n : ℕ}

/-- A Coxeter matrix is simply laced if all off-diagonal entries are `2` or `3`. -/
def SimplyLaced (M : CoxeterMatrix (Fin n)) : Prop :=
  ∀ i j : Fin n, i ≠ j → M i j = 2 ∨ M i j = 3

instance (M : CoxeterMatrix (Fin n)) : Decidable (SimplyLaced M) := by
  unfold SimplyLaced; infer_instance

/-- The Cartan matrix of a simply-laced Coxeter matrix: diagonal `2`, `3 ↦ -1`, otherwise `0`. -/
def cartanOfCoxeter (M : CoxeterMatrix (Fin n)) : Matrix (Fin n) (Fin n) ℤ :=
  fun i j => if i = j then 2 else if M i j = 3 then -1 else 0

/-- A validated root datum (RFC §4 + review §3): the Coxeter matrix is the source of truth, the
Cartan matrix is derived from it, and the simply-laced admissibility condition is checked. -/
structure RootDatum (n : ℕ) where
  coxeter : CoxeterMatrix (Fin n)
  cartan : Matrix (Fin n) (Fin n) ℤ
  wf : cartan = cartanOfCoxeter coxeter
  simplyLaced : SimplyLaced coxeter

/-- Build a root datum from a simply-laced Coxeter matrix. -/
def RootDatum.ofCoxeter (M : CoxeterMatrix (Fin n)) (h : SimplyLaced M) : RootDatum n :=
  ⟨M, cartanOfCoxeter M, rfl, h⟩

theorem RootDatum.cartan_diag (R : RootDatum n) (i : Fin n) : R.cartan i i = 2 := by
  rw [R.wf]; simp [cartanOfCoxeter]

/-- A word in the simple reflections. -/
abbrev Word (n : ℕ) := List (Fin n)

/-- The matrix of the simple reflection `s_i`: `(s_i)_{jk} = δ_{jk} - δ_{ji} * cartan i k`. -/
def refl (R : RootDatum n) (i : Fin n) : Matrix (Fin n) (Fin n) ℤ :=
  fun j k => (if j = k then 1 else 0) - (if j = i then R.cartan i k else 0)

/-- Vector action of `s_i` (RFC §2): only coordinate `i` changes,
`(s_i x)_i = x_i - ∑_j cartan i j * x_j`. -/
theorem refl_mulVec (R : RootDatum n) (i : Fin n) (x : Fin n → ℤ) (k : Fin n) :
    (refl R i *ᵥ x) k = if k = i then x k - ∑ j, R.cartan i j * x j else x k := by
  simp only [mulVec, dotProduct, refl, sub_mul, Finset.sum_sub_distrib, ite_mul, one_mul,
    zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  split_ifs <;> simp

/-- **K3 (involution).** Every simple reflection squares to the identity; this uses exactly the
diagonal condition `cartan i i = 2`. -/
theorem refl_mul_self (R : RootDatum n) (i : Fin n) : refl R i * refl R i = 1 := by
  ext j k
  have hd := R.cartan_diag i
  simp only [refl, mul_apply, sub_mul, mul_sub, ite_mul, one_mul, zero_mul, mul_ite, mul_one,
    mul_zero, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_univ,
    if_true, one_apply]
  by_cases hji : j = i <;> by_cases hjk : j = k <;> by_cases hik : i = k <;>
    subst_vars <;> simp_all; ring

/-- The simple reflection as a unit of the integer matrix ring. -/
def reflUnit (R : RootDatum n) (i : Fin n) : (Matrix (Fin n) (Fin n) ℤ)ˣ :=
  ⟨refl R i, refl R i, refl_mul_self R i, refl_mul_self R i⟩

/-- Evaluation of a word: `wordMat [i₀, …, i_k] = s_{i₀} * ⋯ * s_{i_k}`. -/
def wordMat (R : RootDatum n) (w : Word n) : Matrix (Fin n) (Fin n) ℤ :=
  (w.map (refl R)).prod

@[simp] theorem wordMat_nil (R : RootDatum n) : wordMat R [] = 1 := rfl

/-- **K3.** `wordMat [i] = refl R i`. -/
@[simp] theorem wordMat_singleton (R : RootDatum n) (i : Fin n) : wordMat R [i] = refl R i := by
  simp [wordMat]

theorem wordMat_cons (R : RootDatum n) (i : Fin n) (w : Word n) :
    wordMat R (i :: w) = refl R i * wordMat R w := by
  simp [wordMat]

/-- **K3.** `wordMat` turns concatenation into matrix multiplication. -/
theorem wordMat_append (R : RootDatum n) (w v : Word n) :
    wordMat R (w ++ v) = wordMat R w * wordMat R v := by
  simp [wordMat, List.prod_append]

/-- **K3.** `wordMat` as a monoid homomorphism from the free monoid on `Fin n`. -/
def wordMatHom (R : RootDatum n) : FreeMonoid (Fin n) →* Matrix (Fin n) (Fin n) ℤ :=
  FreeMonoid.lift (refl R)

theorem wordMatHom_apply (R : RootDatum n) (w : Word n) :
    wordMatHom R (FreeMonoid.ofList w) = wordMat R w := by
  simp [wordMatHom, wordMat, FreeMonoid.lift_apply]

/-- The inverse of a word is its reverse (the generators are involutions). -/
theorem wordMat_mul_reverse (R : RootDatum n) (w : Word n) :
    wordMat R w * wordMat R w.reverse = 1 := by
  induction w with
  | nil => simp
  | cons i w ih =>
    rw [wordMat_cons, List.reverse_cons, wordMat_append, wordMat_singleton]
    calc refl R i * wordMat R w * (wordMat R w.reverse * refl R i)
        = refl R i * (wordMat R w * wordMat R w.reverse) * refl R i := by noncomm_ring
      _ = 1 := by rw [ih, mul_one, refl_mul_self]

/-- The semantic group of the RFC (review §3): the subgroup of invertible integer matrices
generated by the simple reflections. -/
def MatrixW (R : RootDatum n) : Subgroup (Matrix (Fin n) (Fin n) ℤ)ˣ :=
  Subgroup.closure (Set.range (reflUnit R))

end SpectrumVM

end
