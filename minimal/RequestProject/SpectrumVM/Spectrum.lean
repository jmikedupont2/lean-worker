module

public import RequestProject.SpectrumVM.Compute

/-!
# SpectrumVM §3/§4/§5: the semantic group, spectra, K4 and coverage

* `MatrixW R` (review §3) is the subgroup of invertible integer matrices generated by the simple
  reflections.  `mem_MatrixW_iff` shows its elements are exactly the word matrices; the key step is
  `closure_eq_of_involutive` (RFC C1: for involutive generators, monoid closure = group closure).
* `omega R = {orderOf g | g ∈ MatrixW R}` is the spectrum of `MatrixW R`; results are scoped to this
  matrix group (review §3, option 1).  Identification with the abstract Coxeter group is **not**
  claimed here.
* K4 (downward closure) for positive orders.
* Proof-carrying spectra (review §6): an `ObservedSpectrum` carries order certificates, hence a
  proof that its orders lie in `omega R`; a `VerifiedSpectrum` additionally carries a proof of
  completeness.  A coverage *label* is computed from the evidence, never supplied.
-/

@[expose] public section

namespace SpectrumVM

open Matrix

variable {n : ℕ}

/-- **C1, involution lemma.** In a group, if every generator is an involution, the submonoid
generated by them coincides (as a set) with the subgroup generated by them. -/
theorem closure_eq_of_involutive {G : Type*} [Group G] (S : Set G) (hS : ∀ s ∈ S, s * s = 1) :
    ((Subgroup.closure S : Subgroup G) : Set G) = (Submonoid.closure S : Set G) := by
  have hinv : ∀ x ∈ Submonoid.closure S, x⁻¹ ∈ Submonoid.closure S := by
    intro x hx
    induction hx using Submonoid.closure_induction with
    | mem y hy =>
      have : y⁻¹ = y := inv_eq_of_mul_eq_one_right (hS y hy)
      rw [this]; exact Submonoid.subset_closure hy
    | one => simp [(Submonoid.closure S).one_mem]
    | mul a b _ _ ha hb => rw [_root_.mul_inv_rev]; exact (Submonoid.closure S).mul_mem hb ha
  apply le_antisymm
  · intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx => exact Submonoid.subset_closure hx
    | one => exact (Submonoid.closure S).one_mem
    | mul x y _ _ hx hy => exact (Submonoid.closure S).mul_mem hx hy
    | inv x _ hx => exact hinv x hx
  · exact Submonoid.closure_le.mpr (fun x hx => Subgroup.subset_closure hx)

/-- Word matrices as units. -/
def wordUnit (R : RootDatum n) (w : Word n) : (Matrix (Fin n) (Fin n) ℤ)ˣ :=
  (w.map (reflUnit R)).prod

theorem coe_wordUnit (R : RootDatum n) (w : Word n) :
    ((wordUnit R w : (Matrix (Fin n) (Fin n) ℤ)ˣ) : Matrix (Fin n) (Fin n) ℤ) = wordMat R w := by
  induction w with
  | nil => simp [wordUnit]
  | cons i w ih =>
    simp only [wordUnit, List.map_cons, List.prod_cons, Units.val_mul] at ih ⊢
    rw [ih, wordMat_cons]; rfl

/-- Elements of `MatrixW R` are exactly the matrices of words. -/
theorem mem_MatrixW_iff (R : RootDatum n) (g : (Matrix (Fin n) (Fin n) ℤ)ˣ) :
    g ∈ MatrixW R ↔ ∃ w : Word n, (g : Matrix (Fin n) (Fin n) ℤ) = wordMat R w := by
  have hinv : ∀ s ∈ Set.range (reflUnit R), s * s = 1 := by
    rintro _ ⟨i, rfl⟩; ext1; exact refl_mul_self R i
  rw [MatrixW, ← SetLike.mem_coe, closure_eq_of_involutive _ hinv, SetLike.mem_coe]
  constructor
  · intro hg
    induction hg using Submonoid.closure_induction_left with
    | one => exact ⟨[], by simp⟩
    | mul_left x hx y _ ih =>
      obtain ⟨i, rfl⟩ := hx
      obtain ⟨w, hw⟩ := ih
      exact ⟨i :: w, by rw [Units.val_mul, hw, wordMat_cons]; rfl⟩
  · rintro ⟨w, hw⟩
    have : g = wordUnit R w := Units.ext (by rw [hw, coe_wordUnit])
    rw [this, wordUnit]
    apply Submonoid.list_prod_mem
    intro x hx
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hx
    exact Submonoid.subset_closure ⟨i, rfl⟩

theorem wordUnit_mem (R : RootDatum n) (w : Word n) : wordUnit R w ∈ MatrixW R :=
  (mem_MatrixW_iff R _).mpr ⟨w, coe_wordUnit R w⟩

/-- The element-order spectrum `ω(W)` of the matrix group `MatrixW R`. -/
def omega (R : RootDatum n) : Set ℕ := {m | ∃ g ∈ MatrixW R, orderOf g = m}

/-- `ω(W)` computed through words: `m ∈ ω(W)` iff some word matrix has order `m`. -/
theorem mem_omega_iff (R : RootDatum n) (m : ℕ) :
    m ∈ omega R ↔ ∃ w : Word n, orderOf (wordMat R w) = m := by
  constructor
  · rintro ⟨g, hg, rfl⟩
    obtain ⟨w, hw⟩ := (mem_MatrixW_iff R g).mp hg
    exact ⟨w, by rw [← hw, orderOf_units]⟩
  · rintro ⟨w, rfl⟩
    exact ⟨wordUnit R w, wordUnit_mem R w, by rw [← orderOf_units, coe_wordUnit]⟩

/-- **K4 (spectrum downward closure)**, for positive orders. -/
theorem omega_dvd_closed (R : RootDatum n) {m d : ℕ} (hm : m ∈ omega R) (hpos : 0 < m)
    (hd : d ∣ m) : d ∈ omega R := by
  obtain ⟨g, hg, rfl⟩ := hm
  exact ⟨g ^ (orderOf g / d), (MatrixW R).pow_mem hg _,
    orderOf_pow_orderOf_div hpos.ne' hd⟩

/-- A valid order certificate witnesses membership in the spectrum. -/
theorem ValidOrderCert.mem_omega {R : RootDatum n} (c : ValidOrderCert R) :
    c.order.val ∈ omega R :=
  (mem_omega_iff R _).mpr ⟨c.word, c.orderOf_eq⟩

/-- A passing order-certificate replay witnesses membership in the spectrum. -/
theorem mem_omega_of_checkOrderCert {R : RootDatum n} {c : RawOrderCert n}
    (h : checkOrderCert R c = true) : c.order.val ∈ omega R :=
  (mem_omega_iff R _).mpr ⟨c.word, checkOrderCert_sound h⟩

/-- Coverage labels (RFC §3).  These are *reports*: they are computed from evidence objects below
(`ObservedSpectrum.coverage`, `VerifiedSpectrum.coverage`) and are never themselves evidence. -/
inductive Coverage
  | observed
  | external (source : String)
  | verified (authority : String)
  deriving DecidableEq, Repr

/-- An observed spectrum: a finite set of orders, each with a validated order certificate.
Completeness is not claimed. -/
structure ObservedSpectrum (R : RootDatum n) where
  orders : Finset ℕ
  witness : ∀ m ∈ orders, { c : ValidOrderCert R // c.order.val = m }

theorem ObservedSpectrum.subset_omega {R : RootDatum n} (S : ObservedSpectrum R) :
    (S.orders : Set ℕ) ⊆ omega R := by
  intro m hm
  obtain ⟨c, rfl⟩ := S.witness m hm
  exact c.mem_omega

def ObservedSpectrum.coverage {R : RootDatum n} (_ : ObservedSpectrum R) : Coverage :=
  Coverage.observed

/-- A verified spectrum: an observed spectrum together with a proof that it is complete. -/
structure VerifiedSpectrum (R : RootDatum n) extends ObservedSpectrum R where
  complete : omega R ⊆ (orders : Set ℕ)

theorem VerifiedSpectrum.eq_omega {R : RootDatum n} (S : VerifiedSpectrum R) :
    (S.orders : Set ℕ) = omega R :=
  le_antisymm S.toObservedSpectrum.subset_omega S.complete

def VerifiedSpectrum.coverage {R : RootDatum n} (_ : VerifiedSpectrum R) : Coverage :=
  Coverage.verified "Lean kernel"

/-- Coverage propagation for inserting additional certified orders into a *verified* spectrum
(review §7): the insertion preserves completeness, so no assurance is lost. -/
def VerifiedSpectrum.insertWitness {R : RootDatum n} (S : VerifiedSpectrum R)
    (c : ValidOrderCert R) : VerifiedSpectrum R where
  orders := insert c.order.val S.orders
  witness m hm := by
    by_cases h : m = c.order.val
    · exact ⟨c, h.symm⟩
    · exact S.witness m ((Finset.mem_insert.mp hm).resolve_left h)
  complete := fun m hm => by
    simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe]
    exact Or.inr (S.complete hm)

end SpectrumVM

end
