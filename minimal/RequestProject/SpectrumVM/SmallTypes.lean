module

public import RequestProject.SpectrumVM.Closure
public import RequestProject.SpectrumVM.Comparison

/-!
# SpectrumVM M0 acceptance tests and the closure-certificate pilot on small types

* Explicit multiplication-order tests on `A₁`, `A₂` and a commuting pair (RFC §11 M0, §12).
* End-to-end **kernel-established** spectra via closure certificates (RFC §6.1) for `W(A₃)` and
  `W(A₄)`: the group order is a consequence of the replay, and the spectrum is exact.
* Negative test: a closure table with one deleted element is rejected.
-/

@[expose] public section

namespace SpectrumVM

open Matrix

/-- Root datum of type `A₁`. -/
def rdA1 : RootDatum 1 := RootDatum.ofCoxeter (CoxeterMatrix.Aₙ 1) (by decide)
/-- Root datum of type `A₂`. -/
def rdA2 : RootDatum 2 := RootDatum.ofCoxeter (CoxeterMatrix.Aₙ 2) (by decide)
/-- Root datum of type `A₃`. -/
def rdA3 : RootDatum 3 := RootDatum.ofCoxeter (CoxeterMatrix.Aₙ 3) (by decide)
/-- Root datum of type `A₄`. -/
def rdA4 : RootDatum 4 := RootDatum.ofCoxeter (CoxeterMatrix.Aₙ 4) (by decide)

/-! ### Convention tests -/

/-- `A₁`: the reflection is `-1` on the line. -/
theorem A1_refl : refl rdA1 0 = !![-1] := by
  rw [← toMat_lrefl]; decide +kernel

/-- `A₂`: the two simple reflections, as matrices in the simple-root basis. -/
theorem A2_refl0 : refl rdA2 0 = !![-1, 1; 0, 1] := by
  rw [← toMat_lrefl]; decide +kernel

theorem A2_refl1 : refl rdA2 1 = !![1, 0; 1, -1] := by
  rw [← toMat_lrefl]; decide +kernel

/-- `A₂`: `wordMat [0, 1] = s₀ * s₁` (rightmost factor acts first). -/
theorem A2_word01 : wordMat rdA2 [0, 1] = !![0, -1; 1, -1] := by
  rw [← toMat_lword]; decide +kernel

theorem A2_word10 : wordMat rdA2 [1, 0] = !![-1, 1; -1, 0] := by
  rw [← toMat_lword]; decide +kernel

/-- Reversing the multiplication order visibly changes the action on a non-commuting pair. -/
theorem A2_order_matters : wordMat rdA2 [0, 1] ≠ wordMat rdA2 [1, 0] := by
  rw [A2_word01, A2_word10]; decide

/-- Action convention: `s₀ (s₁ α₀) = s₀ (α₀ + α₁) = α₁`. -/
theorem A2_action : wordMat rdA2 [0, 1] *ᵥ ![1, 0] = ![0, 1] := by
  rw [A2_word01]; decide

/-- A commuting pair in `A₃`: `s₀ s₂ = s₂ s₀`. -/
theorem A3_commuting : wordMat rdA3 [0, 2] = wordMat rdA3 [2, 0] := by
  rw [← toMat_lword, ← toMat_lword]; decide +kernel

/-- The Coxeter element of `A₂` has order 3. -/
theorem A2_coxeter_order : orderOf (wordMat rdA2 [0, 1]) = 3 :=
  checkOrderCert_sound (c := ⟨[0, 1], ⟨[(3, 1)], 3⟩⟩) (by decide +kernel)

/-! ### Closure-certificate pilot: `W(A₃)` -/

/-- Closure certificate for `W(A₃)`: every element as a word (generated by breadth-first search). -/
def closureA3 : List (Word 3) := [[], [0], [1], [2], [0, 1], [0, 2], [1, 0], [1, 2], [2, 1], [0, 1, 0], [0, 1, 2], [0, 2, 1], [1, 0, 2], [1, 2, 1], [2, 1, 0], [0, 1, 0, 2], [0, 1, 2, 1], [0, 2, 1, 0], [1, 0, 2, 1], [1, 2, 1, 0], [0, 1, 0, 2, 1], [0, 1, 2, 1, 0], [1, 0, 2, 1, 0], [0, 1, 0, 2, 1, 0]]

set_option maxRecDepth 100000 in
theorem closureA3_ok : checkClosureCert rdA3 closureA3 [3, 4] = true := by decide +kernel

/-- `|W(A₃)| = 24`, as a consequence of the closure certificate. -/
theorem card_W_A3 : Nat.card (MatrixW rdA3) = 24 := by
  rw [card_MatrixW_of_closureCert closureA3_ok]; rfl

/-- The exact, kernel-established spectrum of `W(A₃)`. -/
theorem omega_A3 : omega rdA3 = ({1, 2, 3, 4} : Finset ℕ) := by
  rw [omega_eq_of_closureCert closureA3_ok (by decide) ?_,
    divClosure_eq_divisorsOf _ (by decide)]
  · congr 1; decide +kernel
  · intro m hm
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl
    · exact mem_omega_of_checkOrderCert (c := ⟨[0, 1], ⟨[(3, 1)], 3⟩⟩) (by decide +kernel)
    · exact mem_omega_of_checkOrderCert (c := ⟨[0, 1, 2], ⟨[(2, 2)], 4⟩⟩) (by decide +kernel)

/-- Negative test (RFC §12): deleting one element from the closure table makes replay fail. -/
theorem closureA3_deleted_fails :
    checkClosureCert rdA3 (closureA3.erase [0, 1, 0, 2, 1, 0]) [3, 4] = false := by
  decide +kernel

/-- Negative test: a wrong claimed maximum set (`[3]`) is rejected. -/
theorem closureA3_wrong_maxima_fails : checkClosureCert rdA3 closureA3 [3] = false := by
  decide +kernel

/-! ### Closure-certificate pilot: `W(A₄)` -/

