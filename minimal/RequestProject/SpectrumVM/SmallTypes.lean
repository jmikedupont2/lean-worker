def closureA4 : List (Word 4) := [[], [0], [1], [2], [3], [0, 1], [0, 2], [0, 3], [1, 0], [1, 2], [1, 3], [2, 1], [2, 3], [3, 2], [0, 1, 0], [0, 1, 2], [0, 1, 3], [0, 2, 1], [0, 2, 3], [0, 3, 2], [1, 0, 2], [1, 0, 3], [1, 2, 1], [1, 2, 3], [1, 3, 2], [2, 1, 0], [2, 1, 3], [2, 3, 2], [3, 2, 1], [0, 1, 0, 2], [0, 1, 0, 3], [0, 1, 2, 1], [0, 1, 2, 3], [0, 1, 3, 2], [0, 2, 1, 0], [0, 2, 1, 3], [0, 2, 3, 2], [0, 3, 2, 1], [1, 0, 2, 1], [1, 0, 2, 3], [1, 0, 3, 2], [1, 2, 1, 0], [1, 2, 1, 3], [1, 2, 3, 2], [1, 3, 2, 1], [2, 1, 0, 3], [2, 1, 3, 2], [2, 3, 2, 1], [3, 2, 1, 0], [0, 1, 0, 2, 1], [0, 1, 0, 2, 3], [0, 1, 0, 3, 2], [0, 1, 2, 1, 0], [0, 1, 2, 1, 3], [0, 1, 2, 3, 2], [0, 1, 3, 2, 1], [0, 2, 1, 0, 3], [0, 2, 1, 3, 2], [0, 2, 3, 2, 1], [0, 3, 2, 1, 0], [1, 0, 2, 1, 0], [1, 0, 2, 1, 3], [1, 0, 2, 3, 2], [1, 0, 3, 2, 1], [1, 2, 1, 0, 3], [1, 2, 1, 3, 2], [1, 2, 3, 2, 1], [1, 3, 2, 1, 0], [2, 1, 0, 3, 2], [2, 1, 3, 2, 1], [2, 3, 2, 1, 0], [0, 1, 0, 2, 1, 0], [0, 1, 0, 2, 1, 3], [0, 1, 0, 2, 3, 2], [0, 1, 0, 3, 2, 1], [0, 1, 2, 1, 0, 3], [0, 1, 2, 1, 3, 2], [0, 1, 2, 3, 2, 1], [0, 1, 3, 2, 1, 0], [0, 2, 1, 0, 3, 2], [0, 2, 1, 3, 2, 1], [0, 2, 3, 2, 1, 0], [1, 0, 2, 1, 0, 3], [1, 0, 2, 1, 3, 2], [1, 0, 2, 3, 2, 1], [1, 0, 3, 2, 1, 0], [1, 2, 1, 0, 3, 2], [1, 2, 1, 3, 2, 1], [1, 2, 3, 2, 1, 0], [2, 1, 0, 3, 2, 1], [2, 1, 3, 2, 1, 0], [0, 1, 0, 2, 1, 0, 3], [0, 1, 0, 2, 1, 3, 2], [0, 1, 0, 2, 3, 2, 1], [0, 1, 0, 3, 2, 1, 0], [0, 1, 2, 1, 0, 3, 2], [0, 1, 2, 1, 3, 2, 1], [0, 1, 2, 3, 2, 1, 0], [0, 2, 1, 0, 3, 2, 1], [0, 2, 1, 3, 2, 1, 0], [1, 0, 2, 1, 0, 3, 2], [1, 0, 2, 1, 3, 2, 1], [1, 0, 2, 3, 2, 1, 0], [1, 2, 1, 0, 3, 2, 1], [1, 2, 1, 3, 2, 1, 0], [2, 1, 0, 3, 2, 1, 0], [0, 1, 0, 2, 1, 0, 3, 2], [0, 1, 0, 2, 1, 3, 2, 1], [0, 1, 0, 2, 3, 2, 1, 0], [0, 1, 2, 1, 0, 3, 2, 1], [0, 1, 2, 1, 3, 2, 1, 0], [0, 2, 1, 0, 3, 2, 1, 0], [1, 0, 2, 1, 0, 3, 2, 1], [1, 0, 2, 1, 3, 2, 1, 0], [1, 2, 1, 0, 3, 2, 1, 0], [0, 1, 0, 2, 1, 0, 3, 2, 1], [0, 1, 0, 2, 1, 3, 2, 1, 0], [0, 1, 2, 1, 0, 3, 2, 1, 0], [1, 0, 2, 1, 0, 3, 2, 1, 0], [0, 1, 0, 2, 1, 0, 3, 2, 1, 0]]

set_option maxRecDepth 100000 in
theorem closureA4_ok : checkClosureCert rdA4 closureA4 [4, 5, 6] = true := by decide +kernel

/-- `|W(A₄)| = 120`, as a consequence of the closure certificate. -/
theorem card_W_A4 : Nat.card (MatrixW rdA4) = 120 := by
  rw [card_MatrixW_of_closureCert closureA4_ok]; rfl

/-- The exact, kernel-established spectrum of `W(A₄)`. -/
theorem omega_A4 : omega rdA4 = ({1, 2, 3, 4, 5, 6} : Finset ℕ) := by
  rw [omega_eq_of_closureCert closureA4_ok (by decide) ?_,
    divClosure_eq_divisorsOf _ (by decide)]
  · congr 1; decide +kernel
  · intro m hm
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl | rfl
    · exact mem_omega_of_checkOrderCert (c := ⟨[0, 1, 2], ⟨[(2, 2)], 4⟩⟩) (by decide +kernel)
    · exact mem_omega_of_checkOrderCert (c := ⟨[0, 1, 2, 3], ⟨[(5, 1)], 5⟩⟩) (by decide +kernel)
    · exact mem_omega_of_checkOrderCert (c := ⟨[0, 1, 3], ⟨[(2, 1), (3, 1)], 6⟩⟩)
        (by decide +kernel)

/-- Order certificates for every order of `W(A₃)`. -/
def certA3 : ℕ → RawOrderCert 3
  | 2 => ⟨[0], ⟨[(2, 1)], 2⟩⟩
  | 3 => ⟨[0, 1], ⟨[(3, 1)], 3⟩⟩
  | 4 => ⟨[0, 1, 2], ⟨[(2, 2)], 4⟩⟩
  | _ => ⟨[], ⟨[], 1⟩⟩

theorem certA3_ok : ∀ m ∈ ({1, 2, 3, 4} : Finset ℕ),
    checkOrderCert rdA3 (certA3 m) = true ∧ (certA3 m).order.val = m := by
  decide +kernel

/-- A proof-carrying verified spectrum object for `W(A₃)`: each order has a replayed certificate
and completeness is the kernel-established theorem `omega_A3`. -/
def verifiedA3 : VerifiedSpectrum rdA3 where
  orders := {1, 2, 3, 4}
  witness m hm := ⟨⟨certA3 m, (certA3_ok m hm).1⟩, (certA3_ok m hm).2⟩
  complete := by rw [omega_A3]

end SpectrumVM

end
